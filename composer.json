{
    "name": "backcourt/wc-mnm-subscription-editing",
    "description": "Mix and Match subscription contents in-place editing, no cart/checkout.",
    "homepage": "https://github.com/backcourt/wc-mnm-subscription-editing",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "helgatheviking",
            "email": "507025+helgatheviking@users.noreply.github.com"
        }
    ],
    "support": {
        "source": "https://github.com/backcourt/wc-mnm-subscription-editing",
        "issues": "https://github.com/backcourt/wc-mnm-subscription-editing/issues"
    },
    "require": {
        "afragen/git-updater-lite": "^3"
    },
    "require-dev": {
        "wp-cli/i18n-command": "^2.6"
    },
    "scripts": {
        "makepot-audit": [
            "wp --allow-root i18n make-pot . languages/wc-mnm-subscription-editing.pot --slug=wc-mnm-subscription-editing --exclude=\".github,.wordpress-org,build,deploy,node_modules,packages,vendor\" --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/backcourt/wc-mnm-subscription-editing/issues/new\"}'"
        ],
        "makepot": [
            "@makepot-audit --skip-audit"
        ],
        "prefix-namespaces": [
            "sh -c 'test -f bin/strauss.phar || { mkdir -p bin && curl -fL -o bin/strauss.phar https://github.com/BrianHenryIE/strauss/releases/latest/download/strauss.phar; }'",
            "@php bin/strauss.phar",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    },
    "extra": {
        "scripts-description": {
            "makepot": "Generate a .pot file for translation",
            "makepot-audit": "Generate a .pot file for translation. Dry run.",
            "prefix-namespaces": "Download the latest Strauss phar (if needed) and prefix shipped Composer packages into packages/"
        },
        "strauss": {
            "target_directory": "packages",
            "namespace_prefix": "Backcourt\\MNMSubEditing\\Vendor",
            "classmap_prefix": "Backcourt_MNM_Sub_Editing_Vendor_",
            "constant_prefix": "BCMNMSE_"
        }
    }
}
